#!/bin/sh
# Thin wrapper: run the module_crew package from this plugin checkout. The plugin dir goes first on sys.path, ahead of
# the current directory, so a module_crew checkout under the cwd cannot shadow it (crew-command-entry decision 5).
ROOT="$(cd "$(dirname "$0")/.." && pwd)"
exec python3 -c 'import runpy, sys; sys.path.insert(0, sys.argv.pop(1)); sys.argv[0] = "module-crew"; runpy.run_module("module_crew", run_name="__main__", alter_sys=True)' "$ROOT" "$@"
